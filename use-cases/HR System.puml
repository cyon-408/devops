@startuml
left to right direction

actor "HR Advisor" as HR
actor "Department Manager" as DM

rectangle Database

rectangle "HR System" {
    usecase UC1 as "1. Get all salaries"
    usecase UC2 as "2. Get department salaries"
    usecase UC3 as "3. Get my department salaries"
    usecase UC4 as "4. Get salaries by role"
    usecase UC5 as "5. Add new employee"
    usecase UC6 as "6. View employee details"
    usecase UC7 as "7. Update employee details"
    usecase UC8 as "8. Delete employee"

    usecase UCa as "Print report"

    HR -- UC1
    HR -- UC2
    DM -- UC3
    HR -- UC4
    HR -- UC5
    HR -- UC6
    HR -- UC7
    HR -- UC8

    UC1 ..> UCa : <<include>>
    UC2 ..> UCa : <<include>>
    UC3 ..> UCa : <<include>>
    UC4 ..> UCa : <<include>>

    UC1 -- Database
    UC2 -- Database
    UC3 -- Database
    UC4 -- Database
    UC5 -- Database
    UC6 -- Database
    UC7 -- Database
    UC8 -- Database
}
@enduml